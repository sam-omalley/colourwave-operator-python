# Python port of the ColourWave control-panel UI.
#
# Go UI was built from the repo root because it shared the root go.mod.
# Python has no such constraint — each component has its own requirements.txt
# and can be built from its own directory.
#
# Build (from this directory):
#   podman build --platform linux/amd64 -t harbor.lizardnode.com/colourwave/ui-py:v0.1.0 .
# Push:
#   podman push harbor.lizardnode.com/colourwave/ui-py:v0.1.0

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8080

CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "app:app"]
